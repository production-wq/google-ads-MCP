# Copy to .env.local for local work. Never commit actual secrets.
# This project is configured for one company's shared login.
MCP_AUTH_MODE=shared-login
MCP_RESOURCE_URL=https://YOUR-PROJECT.vercel.app/api/mcp
MCP_LOGIN_USERNAME=company
# Generate with: npm run login:password
MCP_LOGIN_PASSWORD_HASH=
# Durable storage for OAuth clients, browser flows, and tokens.
UPSTASH_REDIS_REST_URL=https://YOUR-REDIS.upstash.io
UPSTASH_REDIS_REST_TOKEN=
# Optional for browser-origin MCP clients; leave blank for server-to-server clients.
MCP_ALLOWED_ORIGINS=

# The fixed company Google Sheet is the primary worksheet source.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_BUDGET_RANGE=Budget!A1:D1000
# Legacy CSV fallback. Leave unset when using the Google Sheet.
BLOB_READ_WRITE_TOKEN=
CSV_BLOB_PATH=worksheets/budget.csv
CSV_LOCAL_PATH=

# Server-owned Google credentials for the one company account and sheet.
# The refresh token must include Google Ads adwords and Sheets readonly scopes.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Comma-separated approved IDs. Put the one shared account ID here.
GOOGLE_ADS_ALLOWED_CUSTOMER_IDS=
GOOGLE_ADS_API_VERSION=v25
