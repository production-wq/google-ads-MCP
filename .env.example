# Copy to .env.local. Never commit actual secrets.
MCP_RESOURCE_URL=https://YOUR-PROJECT.vercel.app/api/mcp

# ---------------------------------------------------------------- sign-in
# Signs session tokens and mutation confirmations. openssl rand -hex 32
# Rotating this logs everyone out and voids pending confirmations.
SESSION_SECRET=
# Internal users. Create each entry with:
#   npm run user:hash -- <username> <password> write     (or: read)
# role "write" may change Google Ads and the sheet; "read" cannot.
MCP_USERS_JSON={}
# How long a token from /login stays valid. Default 720 (30 days).
SESSION_TTL_HOURS=720
# Optional machine keys, one per client, 32+ chars: openssl rand -hex 32
# {"jana-laptop":"KEY"} is read-only; {"ci":{"key":"KEY","role":"write"}} may write.
MCP_API_KEYS_JSON={}
MCP_ALLOWED_ORIGINS=

# This app is its own OAuth server, so hosted connectors (Claude Desktop's
# Connectors screen, claude.ai, ChatGPT) can sign in with the usernames and
# passwords above. Nothing to configure. How long a refresh token lasts:
OAUTH_REFRESH_TTL_DAYS=90
# Only set these to delegate sign-in to an EXTERNAL provider instead. Leaving
# them empty keeps the built-in server, which is the recommended setup.
OAUTH_ISSUER=
OAUTH_JWKS_URL=
OAUTH_ALLOWED_SUBJECTS=

# ------------------------------------------------------------ Google login
# One OAuth client (type "Desktop app") and one refresh token carrying BOTH the
# adwords and spreadsheets scopes. Mint it with: npm run google:token
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
# The manager (MCC) account ID that owns the client accounts.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25

# ------------------------------------------------------------- permissions
# Accounts the AI may READ. Empty denies every Ads query.
GOOGLE_ADS_ALLOWED_CUSTOMER_IDS=
# Accounts the AI may CHANGE. Empty denies every write. Must be a subset of the
# line above. Keep this as short as possible.
GOOGLE_ADS_WRITE_CUSTOMER_IDS=
# Refuse any daily budget above this, in the account currency.
MAX_DAILY_BUDGET=1000
# Refuse a budget change larger than this percentage of the current budget.
MAX_BUDGET_CHANGE_PERCENT=50
# How long a confirmation token stays valid, in seconds (60-3600).
CONFIRM_TTL_SECONDS=600

# ----------------------------------------------------------- master sheet
# The Google Sheet this MCP reads, answers from and writes to. Take the ID from
# the URL: docs.google.com/spreadsheets/d/<THIS PART>/edit
# The Google account behind the refresh token needs edit access to it.
GOOGLE_SHEETS_SPREADSHEET_ID=
# Tab holding Account name / Customer ID / Ad target spend / Comments.
SHEETS_ACCOUNTS_TAB=Budget
# Tab this service appends every change to. Created by npm run setup:check.
SHEETS_AUDIT_TAB=MCP Audit Log

# ------------------------------------------------- CSV fallback (optional)
# Only used when GOOGLE_SHEETS_SPREADSHEET_ID is empty.
BLOB_READ_WRITE_TOKEN=
CSV_BLOB_PATH=worksheets/budget.csv
# Local development only; reread every call. Ignored on Vercel.
CSV_LOCAL_PATH=
