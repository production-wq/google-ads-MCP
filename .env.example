# Copy to .env.local. Never commit actual secrets.
MCP_RESOURCE_URL=https://YOUR-PROJECT.vercel.app/api/mcp
# External MCP-capable OAuth provider for hosted ChatGPT/Claude clients.
# API audience must equal MCP_RESOURCE_URL; required scope: ads:read.
OAUTH_ISSUER=
OAUTH_JWKS_URL=
# Comma-separated approved OAuth sub IDs. Empty rejects everyone.
OAUTH_ALLOWED_SUBJECTS=
# Optional separate keys for clients that accept Authorization headers.
# Generate each key with: openssl rand -hex 32
MCP_API_KEYS_JSON={}
MCP_ALLOWED_ORIGINS=
# Private Blob store credential; never a public CSV URL.
BLOB_READ_WRITE_TOKEN=
CSV_BLOB_PATH=worksheets/budget.csv
# Local development only; reread every call. Ignored on Vercel.
CSV_LOCAL_PATH=
# Server-owned Google Ads credentials for ONE organization.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Comma-separated approved IDs. Empty denies all Ads queries.
GOOGLE_ADS_ALLOWED_CUSTOMER_IDS=
GOOGLE_ADS_API_VERSION=v25
